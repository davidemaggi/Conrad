# syntax=docker/dockerfile:1
# Conrad with PKCS#11 (HSM) support: CGO build on Debian. Mount your vendor's
# PKCS#11 module and set CONRAD_PKCS11_MODULE / CONRAD_PKCS11_TOKEN_LABEL / CONRAD_PKCS11_PIN(_FILE).
#   docker build -f deploy/Dockerfile.pkcs11 -t conrad:pkcs11 .
# "--target test" runs the PKCS#11 tests against SoftHSM.

FROM --platform=$BUILDPLATFORM node:24-alpine AS web
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
RUN mkdir -p ../internal/web/dist && npm run build

FROM golang:1.26-bookworm AS build
ARG VERSION=dev
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=web /src/internal/web/dist ./internal/web/dist
RUN CGO_ENABLED=1 go build -tags pkcs11 -trimpath -ldflags "-s -w -X main.version=${VERSION}" -o /out/conrad ./cmd/conrad

FROM build AS test
RUN apt-get update && apt-get install -y --no-install-recommends softhsm2 && rm -rf /var/lib/apt/lists/* \
 && softhsm2-util --init-token --free --label conrad-test --pin 1234 --so-pin 1234
ENV CONRAD_TEST_PKCS11_MODULE=/usr/lib/softhsm/libsofthsm2.so
RUN CGO_ENABLED=1 go test -tags pkcs11 ./internal/crypto/signer/ ./internal/server/ -run 'PKCS11' -v

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 65532 --home /data conrad && mkdir -p /data && chown conrad /data
COPY --from=build /out/conrad /usr/local/bin/conrad
USER conrad
ENV CONRAD_DATA_DIR=/data
VOLUME /data
EXPOSE 80 443
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s CMD ["/usr/local/bin/conrad", "healthcheck"]
ENTRYPOINT ["/usr/local/bin/conrad"]
CMD ["serve"]
